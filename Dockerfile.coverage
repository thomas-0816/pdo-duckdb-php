# docker build --progress=plain -f Dockerfile.coverage -t pdo_duckdb_coverage .
# docker run --rm -w /pdo-duckdb-php/ pdo_duckdb_coverage /bin/sh -c 'tar -cf - ./coverage/' | tar -xvf - --one-top-level=coverage/
# ungoogled-chromium coverage/coverage/index.html

FROM ubuntu:24.04

ENV TERM="xterm-256color"
ENV LC_ALL="C.UTF-8"
ENV DEBIAN_FRONTEND="noninteractive"
ENV CC="clang"
ENV CXX="clang++"
ENV CFLAGS="-O0 -fprofile-instr-generate -fcoverage-mapping"
ENV CXXFLAGS="-O0 -fprofile-instr-generate -fcoverage-mapping"
ENV LDFLAGS="-fprofile-instr-generate"
ENV LLVM_PROFILE_FILE="/tmp/profile-%p-%m.profraw"

SHELL ["/bin/bash", "-c"]

RUN <<EOF
    set -euxo pipefail
    apt-get -y update
    apt-get -y --no-install-recommends install apt-transport-https curl ca-certificates unzip build-essential llvm clang libclang-rt-dev autoconf tzdata
    ln -sf /usr/share/zoneinfo/Europe/Berlin /etc/localtime
    echo "deb https://packages.sury.org/php/ noble main" >/etc/apt/sources.list.d/ondrej-php.list
    curl -s https://packages.sury.org/php/apt.gpg >/etc/apt/trusted.gpg.d/php.gpg
    apt-get -y update
    apt-get -y --no-install-recommends install php8.5-cli php8.5-sqlite3 php8.5-swoole php8.5-curl php8.5-dev
EOF

COPY ./ ./pdo-duckdb-php
WORKDIR /pdo-duckdb-php

RUN <<EOF
    set -euo pipefail
    make clean || true
    curl -fsSL "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-static-libs-linux-amd64.tar.gz" -o duckdb-static-libs-linux-amd64.tar.gz
    tar xvzf duckdb-static-libs-linux-amd64.tar.gz
    tar xvzf libduckdb-src.tar.gz
    phpize
    ./configure --with-pdo-duckdb
    make -j$(nproc)
    TEST_EXTENSIONS="pdo_sqlite" NO_INTERACTION=1 TEST_PHP_ARGS="--show-diff --show-clean -q -j$(nproc)" make test
    TEST_EXTENSIONS="sockets curl mysqlnd pdo_sqlite swoole" NO_INTERACTION=1 TEST_PHP_ARGS="--show-diff --show-clean -q -j$(nproc)" make test

    llvm-profdata merge -sparse /tmp/*.profraw -o /tmp/coverage.profdata
    llvm-cov report modules/pdo_duckdb.so -instr-profile=/tmp/coverage.profdata -ignore-filename-regex='\.(h|hpp)$' | tee /tmp/report.txt
    awk '/^TOTAL/ {print "Code Coverage: " $10}' /tmp/report.txt
    rm -rf coverage
    llvm-cov show modules/pdo_duckdb.so -instr-profile=/tmp/coverage.profdata -format=html -output-dir=coverage -ignore-filename-regex='\.(h|hpp)$'
    apt-get upgrade -y && apt-get clean
    rm -rf /tmp/* /var/lib/apt/lists/* /var/cache/apt/archives/*
EOF
